  <rdf:Description rdf:about="https://cir4fun.eu/data#assemblyinstruction_1TtVsQ">
    <rdf:type rdf:resource="http://www.w3id.org/pdto#AssemblyInstruction"/>
    <ns4:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chair Assembly For Manufacturing</ns4:name>
    <rdfs:label>assemblyInstruction_Chair_Assembly_For_Manufacturing_1TtVsQ</rdfs:label>
    <rdfs:comment>Assembly instruction of Chair Assembly For Manufacturing with ID 1TtVsQ</rdfs:comment>
    <ns4:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To assemble the chair, place the seat upside down on a soft surface and attach the four legs by aligning them with the corner holes and tightening the screws lightly using the provided Allen key. Next, position the backrest at the rear of the seat, align the holes, and insert and tighten the remaining screws securely. Once all parts are connected, check that the chair is level, fully tighten all screws, and turn the chair upright. Assemble the chair on a flat surface and avoid overtightening the screws.</ns4:description>
    <pdto:hasTargetAudience rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Professional</pdto:hasTargetAudience>
  </rdf:Description>
