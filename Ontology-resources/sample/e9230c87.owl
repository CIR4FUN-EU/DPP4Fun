  <rdf:Description rdf:about="https://cir4fun.eu/data#disassemblyinstruction_QMj08R">
    <rdf:type rdf:resource="http://www.w3id.org/pdto#AssemblyInstruction"/>
    <ns4:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chair Disassembly For Manufacturing</ns4:name>
    <rdfs:label>assemblyInstruction_Chair_Disassembly_For_Manufacturing_QMj08R</rdfs:label>
    <rdfs:comment>Assembly instruction of Chair Disassembly For Manufacturing with ID QMj08R</rdfs:comment>
    <ns4:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">To disassemble the chair, place it upside down on a soft and flat surface, then use the Allen key to loosen and remove all screws securing the backrest to the seat before carefully separating the backrest. Next, remove the screws attaching each leg to the seat and detach the legs one by one. Keep all screws and small parts together to avoid loss during storage or transport, and store the chair components in a dry and safe place to prevent damage.</ns4:description>
    <pdto:hasTargetAudience rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Professional</pdto:hasTargetAudience>
  </rdf:Description>
