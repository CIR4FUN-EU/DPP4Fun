  <rdf:Description rdf:about="https://cir4fun.eu/data#disposalinstruction_WlThpE">
    <rdf:type rdf:resource="http://www.w3id.org/pdto#DisposalInstruction"/>
    <ns3:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">End-of-Life Disposal</ns3:name>
    <rdfs:label>disposalInstruction_End-of-Life_Disposal_WlThpE</rdfs:label>
    <rdfs:comment>Disposal instruction of End-of-Life Disposal with ID WlThpE</rdfs:comment>
    <ns3:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">At the end of the chair’s service life, disassemble all components and separate the materials such as metal, plastic, wood, and fabric where applicable. Dispose of each material according to local recycling and waste management regulations. Reusable parts should be recovered whenever possible, and damaged or non-recyclable components must be disposed of through an authorized waste collection facility. Do not dispose of the chair in natural environments or with uncontrolled household waste.</ns3:description>
