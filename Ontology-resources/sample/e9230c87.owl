    <rdfs:comment>CarbonFootprint calculation with ID sTJXFP</rdfs:comment>
    <pdto:hasPhase rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Transport</pdto:hasPhase>
    <pdto:hasPcfCO2eq rdf:datatype="http://www.w3.org/2001/XMLSchema#double">3.03</pdto:hasPcfCO2eq>
    <pdto:hasPcfQuantityOfMeasurementForCalculation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">100 km</pdto:hasPcfQuantityOfMeasurementForCalculation>
