<https://cir4fun.eu/data#assemblyinstruction_UcxmLf> a pdto:AssemblyInstruction ;
    rdfs:label "assemblyInstruction_Chair_Assembly_For_Manufacturing_UcxmLf" ;
    ns1:description "To assemble the chair, place the seat upside down on a soft surface and attach the four legs by aligning them with the corner holes and tightening the screws lightly using the provided Allen key. Next, position the backrest at the rear of the seat, align the holes, and insert and tighten the remaining screws securely. Once all parts are connected, check that the chair is level, fully tighten all screws, and turn the chair upright. Assemble the chair on a flat surface and avoid overtightening the screws."^^xsd:string ;
    ns1:name "Chair Assembly For Manufacturing"^^xsd:string ;
    rdfs:comment "Assembly instruction of Chair Assembly For Manufacturing with ID UcxmLf" ;
    pdto:hasTargetAudience "Professional"^^xsd:string .

