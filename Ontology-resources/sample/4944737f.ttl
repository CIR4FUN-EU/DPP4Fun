<https://cir4fun.eu/data#disassemblyinstruction_znlqG0> a pdto:AssemblyInstruction ;
    rdfs:label "assemblyInstruction_Sofa_Disassembly_for_End-of-Life_znlqG0" ;
    ns1:description "Disassemble the Gala 3-seater sofa into its main components for recycling or safe disposal. Remove cushions, detach upholstery, separate wooden frame and legs, and collect fasteners. Sort materials according to type (wood, textile, foam, metal) for proper waste management."^^xsd:string ;
    ns1:name "Sofa Disassembly for End-of-Life"^^xsd:string ;
    rdfs:comment "Assembly instruction of Sofa Disassembly for End-of-Life with ID znlqG0" ;
    pdto:hasTargetAudience "Professional"^^xsd:string .

<https://cir4fun.eu/data#disposalinstruction_oY7cPv> a pdto:DisposalInstruction ;
    rdfs:label "disposalInstruction_End-of-Life_Disposal_oY7cPv" ;
    ns1:description "Separate sofa components for proper disposal. - Upholstery fabric: recycle if textile recycling facilities available; otherwise, dispose according to local regulations. - Wooden frame: send to wood recycling or energy recovery if recycling unavailable. - Cushions: foam can be recycled if supported; otherwise, dispose safely. - Metal fasteners and connectors: recycle as scrap metal. Ensure components are dismantled and sorted to maximize recycling and minimize landfill."^^xsd:string ;
    ns1:name "End-of-Life Disposal"^^xsd:string ;
    rdfs:comment "Disposal instruction of End-of-Life Disposal with ID oY7cPv" .

