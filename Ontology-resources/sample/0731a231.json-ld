    {
      "@id": "https://cir4fun.eu/data#assemblyinstruction_c44oCJ",
      "@type": "http://www.w3id.org/pdto#AssemblyInstruction",
      "http://schema.org/description": "Reassemble crib by inspecting structural integrity of wooden frame first. Replace worn fasteners if needed. Reattach side panels and base structure. Install wheels ensuring proper locking mechanism functionality. Verify stability and load capacity before final quality approval.",
