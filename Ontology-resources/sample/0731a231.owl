  <rdf:Description rdf:about="https://cir4fun.eu/data#assemblyinstruction_UM2RbR">
    <rdf:type rdf:resource="http://www.w3id.org/pdto#AssemblyInstruction"/>
    <ns4:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Crib Assembly for Remanufacturing</ns4:name>
    <rdfs:label>assemblyInstruction_Crib_Assembly_for_Remanufacturing_UM2RbR</rdfs:label>
    <rdfs:comment>Assembly instruction of Crib Assembly for Remanufacturing with ID UM2RbR</rdfs:comment>
    <ns4:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reassemble crib by inspecting structural integrity of wooden frame first. Replace worn fasteners if needed. Reattach side panels and base structure. Install wheels ensuring proper locking mechanism functionality. Verify stability and load capacity before final quality approval.</ns4:description>
  </rdf:Description>
