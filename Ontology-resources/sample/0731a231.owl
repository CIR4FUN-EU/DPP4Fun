  <rdf:Description rdf:about="https://cir4fun.eu/data#disposalinstruction_v4RrgH">
    <rdf:type rdf:resource="http://www.w3id.org/pdto#DisposalInstruction"/>
    <ns3:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">End-of-Life Disposal</ns3:name>
    <rdfs:label>disposalInstruction_End-of-Life_Disposal_v4RrgH</rdfs:label>
    <rdfs:comment>Disposal instruction of End-of-Life Disposal with ID v4RrgH</rdfs:comment>
    <ns3:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disassemble the crib into main material streams for proper recycling. - Solid wood components: send to wood recycling or energy recovery. - Melamine board parts: dispose via controlled waste facilities. - Metal fittings: recycle as scrap metal. - Plastic wheels: recycle if local facilities allow, otherwise landfill. Ensure separation of materials before disposal to maximize recycling efficiency.</ns3:description>
  </rdf:Description>
