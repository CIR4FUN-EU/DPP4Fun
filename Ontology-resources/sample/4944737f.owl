  <rdf:Description rdf:about="https://cir4fun.eu/data#disposalinstruction_qkyn2H">
    <rdf:type rdf:resource="http://www.w3id.org/pdto#DisposalInstruction"/>
    <ns4:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">End-of-Life Disposal</ns4:name>
    <rdfs:label>disposalInstruction_End-of-Life_Disposal_qkyn2H</rdfs:label>
    <rdfs:comment>Disposal instruction of End-of-Life Disposal with ID qkyn2H</rdfs:comment>
    <ns4:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Separate sofa components for proper disposal. - Upholstery fabric: recycle if textile recycling facilities available; otherwise, dispose according to local regulations. - Wooden frame: send to wood recycling or energy recovery if recycling unavailable. - Cushions: foam can be recycled if supported; otherwise, dispose safely. - Metal fasteners and connectors: recycle as scrap metal. Ensure components are dismantled and sorted to maximize recycling and minimize landfill.</ns4:description>
  </rdf:Description>
