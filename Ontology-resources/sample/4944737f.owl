  <rdf:Description rdf:about="https://cir4fun.eu/data#disassemblyinstruction_AXYCFX">
    <rdf:type rdf:resource="http://www.w3id.org/pdto#AssemblyInstruction"/>
    <ns3:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sofa Disassembly for End-of-Life</ns3:name>
    <rdfs:label>assemblyInstruction_Sofa_Disassembly_for_End-of-Life_AXYCFX</rdfs:label>
    <rdfs:comment>Assembly instruction of Sofa Disassembly for End-of-Life with ID AXYCFX</rdfs:comment>
    <ns3:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Disassemble the Gala 3-seater sofa into its main components for recycling or safe disposal. Remove cushions, detach upholstery, separate wooden frame and legs, and collect fasteners. Sort materials according to type (wood, textile, foam, metal) for proper waste management.</ns3:description>
